# Copy this file to a private env file (for example: .env.modal) and fill in your values.
#
# Shared worker auth key used by:
# - scheduler (--worker-auth-key or EPOCH_WORKER_AUTH_KEY)
# - worker (--auth-key or EPOCH_WORKER_AUTH_KEY)
#
# If omitted, the system defaults to "superkey" for safety, but you should replace it.
EPOCH_WORKER_AUTH_KEY=replace-with-a-strong-key

# Optional Modal launcher defaults
EPOCH_MODAL_GPU=T4
EPOCH_MODAL_NUM_WORKERS=8
EPOCH_MODAL_APP_NAME=epoch-workers
